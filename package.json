{
	"name": "esportsarenamanager-react",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "oxlint",
		"format": "prettier --write src tests *.js *.cjs *.html *.json",
		"format:check": "prettier --check src tests *.js *.cjs *.html *.json",
		"test": "karma start karma.conf.cjs",
		"preview": "vite preview",
		"test:watch": "karma start karma.conf.cjs --no-single-run --auto-watch",
		"test:cov": "node -e \"require('fs').rmSync('coverage', { recursive: true, force: true })\" && karma start karma.conf.cjs --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"bootstrap": "^5.3.8",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"esbuild-plugin-istanbul": "^0.3.0",
		"jasmine-core": "^4.6.1",
		"karma": "^6.4.4",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.1",
		"karma-esbuild": "^2.3.0",
		"karma-jasmine": "^5.1.0",
		"oxlint": "^1.81.0",
		"prettier": "3.9.10",
		"vite": "^8.3.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
