{
  "openapi": "3.1.0",
  "info": {
    "title": "API Auth - eSports Arena Manager",
    "description": "Registro, login y emisión de JWT. Roles: ROLE_ADMIN, ROLE_ORGANIZADOR, ROLE_JUGADOR",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8099",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Registro, login, renovación del JWT y gestión de cuentas"
    }
  ],
  "paths": {
    "/api/v1/auth/users": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Listar cuentas (ADMIN)",
        "operationId": "listar",
        "responses": {
          "200": {
            "description": "Listado de cuentas sin contraseñas",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CuentaResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "El rol no es ADMIN",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CuentaResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Crear cuenta con rol (ADMIN)",
        "description": "Roles: ROLE_ADMIN, ROLE_ORGANIZADOR, ROLE_JUGADOR",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearCuentaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Cuenta creada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CuentaResponse"
                }
              }
            }
          },
          "403": {
            "description": "El rol no es ADMIN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CuentaResponse"
                }
              }
            }
          },
          "409": {
            "description": "El usuario ya existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CuentaResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar jugador (público)",
        "description": "Crea una cuenta ROLE_JUGADOR, su perfil en user-service y devuelve la sesión (token JWT).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Cuenta creada y sesión iniciada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o perfil rechazado por user-service",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "description": "El usuario ya existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "503": {
            "description": "user-service no disponible",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Renovar token",
        "description": "Con un token vigente entrega uno nuevo. Un token vencido responde 401.",
        "operationId": "refresh",
        "responses": {
          "200": {
            "description": "Token renovado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin token, token vencido o inválido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión (público)",
        "description": "Valida usuario y contraseña (BCrypt) y devuelve el token JWT",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Faltan datos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Cuenta de la sesión actual",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CuentaResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/users/{id}": {
      "delete": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Eliminar cuenta (ADMIN)",
        "operationId": "eliminar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cuenta eliminada"
          },
          "409": {
            "description": "No se puede eliminar la propia cuenta"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CrearCuentaRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 4,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 6
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "correo": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "rol": {
            "type": "string",
            "minLength": 1,
            "pattern": "ROLE_ADMIN|ROLE_ORGANIZADOR|ROLE_JUGADOR"
          }
        },
        "required": [
          "correo",
          "nombre",
          "password",
          "rol",
          "username"
        ]
      },
      "CuentaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "perfilId": {
            "type": "integer",
            "format": "int64"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 4,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 6
          },
          "nombre": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "correo",
          "nombre",
          "password",
          "username"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "rol": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expiraEn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password",
          "username"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}